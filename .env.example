# Copy to .env (dev) or .env.prod (production) and fill in real values.
# Never commit the real files — only this example is tracked.

# --- Domain / TLS (Caddy) ---
DOMAIN=localhost
ACME_EMAIL=you@example.com

# --- Postgres ---
POSTGRES_USER=adventure
POSTGRES_PASSWORD=change-me
POSTGRES_DB=adventuremafia
POSTGRES_PORT=5432
DATABASE_URL=postgres://adventure:change-me@db:5432/adventuremafia

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Local/dev only ---
# Throwaway Postgres used by `npm run test:db` (scripts/test-db.sh sets this itself; rarely needed here).
TEST_DATABASE_URL=
# Local filesystem fallback for operator photo/video uploads when R2 isn't configured. Defaults to .uploads.
UPLOAD_DIR=.uploads

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="The Adventure Mafia <contact@example.com>"
TEAM_EMAIL=contact@example.com

# --- Admin dashboard (username is always "admin") ---
ADMIN_PASSWORD=

# --- Session-signing secrets (generate each with: openssl rand -hex 32) ---
REWARDS_SECRET=
OPERATOR_SESSION_SECRET=

# --- Protects POST /api/internal/sweep (host crontab calls it) ---
CRON_SECRET=

# --- Cloudflare R2 (operator photo uploads) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
